{
  "description": "stackcrew guard: block forbidden constructs in newly written lines",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cli/src/guard/hook.js"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
