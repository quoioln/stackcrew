<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- stackcrew: Spring Boot / Java rules. Run with the Checkstyle Maven or Gradle plugin. -->
<module name="Checker">
  <property name="severity" value="error"/>

  <!-- Production code only: skip anything under src/test (the dots match either path separator). -->
  <module name="BeforeExecutionExclusionFileFilter">
    <property name="fileNamePattern" value=".*src.test.java.*"/>
  </module>

  <module name="TreeWalker">
    <!-- Waivers: a comment on the same line, with a reason, suppresses that rule only (matches the guard and the docs). -->
    <module name="SuppressWithNearbyCommentFilter">
      <property name="commentFormat" value="stackcrew-allow: SC-TYPE [^ ]"/>
      <property name="checkFormat" value="IllegalType"/>
      <property name="influenceFormat" value="0"/>
    </module>
    <module name="SuppressWithNearbyCommentFilter">
      <property name="commentFormat" value="stackcrew-allow: SC-CONST [^ ]"/>
      <property name="checkFormat" value="MagicNumber"/>
      <property name="influenceFormat" value="0"/>
    </module>

    <!-- SC-CONST: magic numbers. Only -1, 0 and 1 are idioms; everything else is a named constant. -->
    <module name="MagicNumber">
      <property name="ignoreNumbers" value="-1, 0, 1"/>
      <property name="ignoreHashCodeMethod" value="true"/>
      <property name="ignoreAnnotation" value="true"/>
    </module>

    <!-- SC-TYPE: untyped JSON trees must not be used as a type. -->
    <module name="IllegalType">
      <property name="illegalClassNames" value="JsonNode, ObjectNode, com.fasterxml.jackson.databind.JsonNode, com.fasterxml.jackson.databind.node.ObjectNode"/>
    </module>

    <!-- SC-REUSE: keep methods small enough to stay at one abstraction level. -->
    <module name="MethodLength">
      <property name="max" value="60"/>
    </module>

    <module name="AvoidStarImport"/>
  </module>
</module>
